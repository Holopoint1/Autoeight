# Cloudflare Pages HTTP headers. (Ignored by GitHub Pages, so safe to commit
# before cutover; becomes active once the site is served by Cloudflare Pages.)

# --- Security headers: safe defaults that do NOT affect rendering ---
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# --- Content-Security-Policy is intentionally NOT enforced yet ---
# The live site uses Google Fonts, Font Awesome (cdnjs), inline styles/scripts,
# and Supabase. A wrong CSP silently breaks fonts/icons/chat. Test this as
# Content-Security-Policy-Report-Only across every page first, then promote:
#
#   Content-Security-Policy: default-src 'self';
#     img-src 'self' data: https:;
#     font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com;
#     style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com;
#     script-src 'self' 'unsafe-inline';
#     connect-src 'self' https://*.supabase.co

# --- Caching ---
# Images/logos rarely change: cache hard.
/brand_assets/*
  Cache-Control: public, max-age=31536000, immutable

# Shared CSS/JS use ?v=YYYYMMDD cache-busting, so a day is safe.
/style.css
  Cache-Control: public, max-age=86400
/main.js
  Cache-Control: public, max-age=86400
/includes.js
  Cache-Control: public, max-age=86400
