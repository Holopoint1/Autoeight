<style>
  .tst-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 24px; max-width: 1180px; margin: 0 auto; }
  .tst-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 32px 28px; display: flex; flex-direction: column; gap: 18px; transition: border-color 0.2s, box-shadow 0.2s; position: relative; }
  .tst-card:hover { border-color: var(--purple); box-shadow: 0 0 36px rgba(109,77,230,0.10), 0 12px 40px rgba(0,0,0,0.06); }
  .tst-quote-icon { width: 40px; height: 40px; border-radius: 10px; display: inline-flex; align-items: center; justify-content: center; background: var(--purple-dim); border: 1px solid rgba(124,92,252,0.25); color: var(--purple-light); font-size: 1rem; }
  .tst-quote { font-size: 1rem; line-height: 1.65; color: var(--text, #1a1a1f); margin: 0; font-weight: 500; }
  .tst-author { display: flex; flex-direction: column; gap: 3px; margin-top: auto; padding-top: 14px; border-top: 1px solid var(--border); }
  .tst-author strong { font-size: 0.92rem; font-weight: 700; letter-spacing: -0.01em; }
  .tst-author span { font-size: 0.8rem; color: var(--muted); }
  .tst-metric { display: inline-flex; align-items: center; gap: 8px; align-self: flex-start; padding: 7px 14px; background: var(--purple-dim); border: 1px solid rgba(124,92,252,0.25); border-radius: 100px; font-size: 0.78rem; font-weight: 700; color: var(--purple-light); letter-spacing: 0.01em; }
  .tst-metric i { font-size: 0.72rem; }
  .tst-intro { max-width: 760px; margin: 0 auto 48px; text-align: center; }
  .tst-intro p { font-size: 0.95rem; line-height: 1.75; color: var(--muted); }
  @media (max-width: 700px) {
    .tst-grid { grid-template-columns: 1fr; gap: 18px; }
    .tst-card { padding: 26px 22px; }
  }
</style>
