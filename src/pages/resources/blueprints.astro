---
import MarketingLayout from '@layouts/MarketingLayout.astro';
---

<MarketingLayout
  title="Automation Blueprints. Autoeight"
  description="Explore Autoeight automation blueprints for AI systems, email workflows, sales automation, and website-led business processes."
  canonical="https://autoeight.ai/resources/blueprints"
  ogType="website"
  ogTitle="Automation Blueprints – Autoeight"
  ogDescription="Explore Autoeight automation blueprints for AI systems, email workflows, sales automation, and website-led business processes."
  ogImage="https://autoeight.ai/brand_assets/logo.png"
  twitterCard="summary_large_image"
  twitterTitle="Automation Blueprints – Autoeight"
>

  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    "name": "Automation Blueprints",
    "description": "Explore Autoeight automation blueprints for AI systems, email workflows, sales automation, and website-led business processes.",
    "url": "https://autoeight.ai/resources/blueprints",
    "publisher": {
      "@type": "Organization",
      "name": "Autoeight",
      "url": "https://autoeight.ai"
    }
  }
  </script>

<div class="page-hero">
    <div class="page-hero-bg"></div>
    <div class="page-hero-grid"></div>
    <div class="page-hero-content">
      <span class="section-label"><i class="fa-solid fa-map"></i> Automation Blueprints</span>
      <h1>See exactly what automation<br /><em>looks like in your business</em></h1>
      <p>Step-by-step flowcharts and real ROI data for every service we offer. No fluff, just what changes, how it works, and what you save.</p>
    </div>
  </div>

  <section class="page-section">
    <div class="page-section-inner">
      <div class="bp-card-grid reveal">

        <a class="bp-card" href="blueprint-ai-automation">
          <div class="bp-card-icon">🤖</div>
          <span class="bp-card-tag">AI &amp; Automation</span>
          <div class="bp-card-stat">7+ hrs/day</div>
          <h3>AI-Powered Process Automation</h3>
          <p>Every repetitive task across your business. Enquiries, data entry, scheduling, admin. Handled automatically by AI.</p>
          <div class="bp-card-cta">View Blueprint <i class="fa-solid fa-arrow-right"></i></div>
        </a>

        <a class="bp-card" href="blueprint-email-automation">
          <div class="bp-card-icon">📧</div>
          <span class="bp-card-tag">Email Automation</span>
          <div class="bp-card-stat">3 hrs/day</div>
          <h3>Email Sequences That Convert</h3>
          <p>Automated welcome flows, nurture campaigns, and follow-up sequences that run 24/7 without your team lifting a finger.</p>
          <div class="bp-card-cta">View Blueprint <i class="fa-solid fa-arrow-right"></i></div>
        </a>

        <a class="bp-card" href="blueprint-sales-automation">
          <div class="bp-card-icon">📈</div>
          <span class="bp-card-tag">Sales Automation</span>
          <div class="bp-card-stat">10× outreach</div>
          <h3>Sales That Scale Without Headcount</h3>
          <p>Automated lead research, personalised outreach, follow-ups, and CRM updates. Your sales team focuses on closing, not admin.</p>
          <div class="bp-card-cta">View Blueprint <i class="fa-solid fa-arrow-right"></i></div>
        </a>

        <a class="bp-card" href="blueprint-web-design">
          <div class="bp-card-icon">🌐</div>
          <span class="bp-card-tag">Web Design</span>
          <div class="bp-card-stat">3× leads</div>
          <h3>A Website That Works While You Sleep</h3>
          <p>A conversion-optimised site fully integrated with your automation stack, so every visitor becomes a tracked opportunity.</p>
          <div class="bp-card-cta">View Blueprint <i class="fa-solid fa-arrow-right"></i></div>
        </a>

      </div>
    </div>
  </section>

  <div class="page-cta">
    <div class="container">
      <div class="cta-box reveal">
        <div class="cta-glow"></div>
        <h2>Want to see this working in your business?</h2>
        <p>Book a free 30-minute audit. We'll map your current processes and show you exactly where automation will save the most time and money.</p>
        <a href="../book" class="btn btn-primary btn-lg"><i class="fa-solid fa-calendar-check"></i> Book your free audit</a>
      </div>
    </div>
  </div>
</MarketingLayout>
