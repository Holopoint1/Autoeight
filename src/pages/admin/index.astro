---
// /admin — landing dashboard. Migrated from admin/index.html.
// Body content copied VERBATIM (everything between the legacy
// <script>AEAuth.check();</script> and the trailing layout.js script,
// both of which are now provided by AdminLayout).
import AdminLayout from '@layouts/AdminLayout.astro';
---

<AdminLayout title="Portal - Autoeight">
  <div class="app-layout">

    <!-- ═══ SIDEBAR ═══ -->
    <aside class="sidebar">
      <a href="/admin" class="sidebar-logo">
        <img src="/brand_assets/logo.png?v=3" alt="Autoeight" />
        <div class="sidebar-logo-text">
          <span class="sidebar-logo-name">Autoeight</span>
          <span class="sidebar-logo-sub">Internal Portal</span>
        </div>
      </a>

      <div class="sidebar-section">Tools</div>
      <nav class="sidebar-nav">
        <a href="/admin" class="sidebar-link active"><i class="fa-solid fa-house"></i> Dashboard</a>
        <a href="/admin/chat" class="sidebar-link"><i class="fa-solid fa-comments"></i> Live Chat</a>
        <a href="/admin/visitors" class="sidebar-link"><i class="fa-solid fa-eye"></i> Visitor Intelligence <span class="sidebar-badge">New</span></a>
        <a href="/admin/seo" class="sidebar-link"><i class="fa-solid fa-chart-simple"></i> SEO &amp; Site Health</a>
        <a href="/admin/skills" class="sidebar-link"><i class="fa-solid fa-book"></i> AI Skills</a>
      </nav>

      <div class="sidebar-section">Pitch Views</div>
      <nav class="sidebar-nav">
        <a href="/admin/support" class="sidebar-link"><i class="fa-solid fa-robot"></i> AI &amp; Automation</a>
        <a href="/admin/data" class="sidebar-link"><i class="fa-solid fa-plug"></i> CRM &amp; Integration</a>
        <a href="/admin/sales" class="sidebar-link"><i class="fa-solid fa-chart-line"></i> Sales Automation</a>
      </nav>

      <div class="sidebar-footer">
        <a href="/" class="sidebar-link"><i class="fa-solid fa-globe"></i> Live Site</a>
        <a href="#" onclick="AEAuth.logout();return false;" class="sidebar-link"><i class="fa-solid fa-right-from-bracket"></i> Sign Out</a>
      </div>
    </aside>

    <!-- ═══ MAIN ═══ -->
    <div class="main-content">
      <div class="topbar">
        <div class="topbar-breadcrumb">
          <span>Portal</span> <span>/</span> <strong>Dashboard</strong>
        </div>
        <div class="topbar-actions">
          <a href="/admin/chat" class="b-btn" style="background:linear-gradient(135deg,#7c5cfc,#6d4de6);color:#fff;border-color:transparent;"><i class="fa-solid fa-comments"></i> Live Chat</a>
          <a href="/admin/visitors" class="b-btn green"><i class="fa-solid fa-eye"></i> Visitor Intelligence</a>
        </div>
      </div>

      <main class="b-main">

        <div class="dw">
          <h1>Welcome back</h1>
          <p>Everything you need for sales demos, SEO monitoring, visitor intelligence, and AI skills reference.</p>
        </div>

        <!-- Quick stats -->
        <div class="quick-stats">
          <div class="qs">
            <div class="qs-val green">65%</div>
            <div class="qs-label">Avg time saved across all roles</div>
          </div>
          <div class="qs">
            <div class="qs-val green">&pound;120k</div>
            <div class="qs-label">Max annual saving (5-person team)</div>
          </div>
          <div class="qs">
            <div class="qs-val amber">10&times;</div>
            <div class="qs-label">Sales outreach volume increase</div>
          </div>
          <div class="qs">
            <div class="qs-val purple">30 days</div>
            <div class="qs-label">Typical time to see results</div>
          </div>
        </div>

        <!-- Sales Demo Cards -->
        <div style="margin-bottom:10px;"><p style="font-size:0.68rem;font-weight:600;text-transform:uppercase;letter-spacing:0.1em;color:var(--subtle);">Sales Demo Sections</p></div>
        <div class="d-grid">

          <a href="/admin/support" class="d-card">
            <div class="d-card-top">
              <div class="d-icon"><i class="fa-solid fa-headset"></i></div>
              <span class="d-num">01 / 07</span>
            </div>
            <div class="d-title">Customer Service</div>
            <div class="d-desc">How AI chatbots handle 60-80% of queries automatically, cutting response times from hours to seconds.</div>
            <div class="d-footer">
              <span class="d-saving">Saves ~&pound;16k/yr</span>
              <span class="d-arrow"><i class="fa-solid fa-arrow-right"></i></span>
            </div>
          </a>

          <a href="/admin/sales" class="d-card">
            <div class="d-card-top">
              <div class="d-icon"><i class="fa-solid fa-chart-line"></i></div>
              <span class="d-num">02 / 07</span>
            </div>
            <div class="d-title">Sales Automation</div>
            <div class="d-desc">From 20-30 manual emails a day to 200-500 personalised outreaches with auto follow-ups.</div>
            <div class="d-footer">
              <span class="d-saving">Saves &pound;20k-&pound;30k/yr</span>
              <span class="d-arrow"><i class="fa-solid fa-arrow-right"></i></span>
            </div>
          </a>

          <a href="/admin/scheduling" class="d-card">
            <div class="d-card-top">
              <div class="d-icon"><i class="fa-solid fa-calendar-check"></i></div>
              <span class="d-num">03 / 07</span>
            </div>
            <div class="d-title">Scheduling</div>
            <div class="d-desc">Automated booking links, calendar sync, and reminders. No more email back-and-forth.</div>
            <div class="d-footer">
              <span class="d-saving">Saves &pound;7k-&pound;10k/yr</span>
              <span class="d-arrow"><i class="fa-solid fa-arrow-right"></i></span>
            </div>
          </a>

          <a href="/admin/marketing" class="d-card">
            <div class="d-card-top">
              <div class="d-icon"><i class="fa-solid fa-bullhorn"></i></div>
              <span class="d-num">04 / 07</span>
            </div>
            <div class="d-title">Marketing</div>
            <div class="d-desc">AI content creation, campaign scheduling, and audience targeting. Cuts production time by 75%.</div>
            <div class="d-footer">
              <span class="d-saving">Saves &pound;20k-&pound;40k/yr</span>
              <span class="d-arrow"><i class="fa-solid fa-arrow-right"></i></span>
            </div>
          </a>

          <a href="/admin/data" class="d-card">
            <div class="d-card-top">
              <div class="d-icon"><i class="fa-solid fa-database"></i></div>
              <span class="d-num">05 / 07</span>
            </div>
            <div class="d-title">Data &amp; Admin</div>
            <div class="d-desc">Connect your tools so data syncs automatically. No more copy-pasting between apps.</div>
            <div class="d-footer">
              <span class="d-saving">Saves ~&pound;15k/yr</span>
              <span class="d-arrow"><i class="fa-solid fa-arrow-right"></i></span>
            </div>
          </a>

          <a href="/admin/projects" class="d-card">
            <div class="d-card-top">
              <div class="d-icon"><i class="fa-solid fa-diagram-project"></i></div>
              <span class="d-num">06 / 07</span>
            </div>
            <div class="d-title">Project Management</div>
            <div class="d-desc">Auto task assignment, deadline tracking, and live dashboards. Nothing falls through the cracks.</div>
            <div class="d-footer">
              <span class="d-saving">Saves &pound;10k-&pound;15k/yr</span>
              <span class="d-arrow"><i class="fa-solid fa-arrow-right"></i></span>
            </div>
          </a>

          <a href="/admin/impact" class="d-card" style="border-color:rgba(62,207,142,0.3);">
            <div class="d-card-top">
              <div class="d-icon" style="background:var(--green);color:#111;border-color:var(--green);"><i class="fa-solid fa-trophy"></i></div>
              <span class="d-num">07 / 07</span>
            </div>
            <div class="d-title">Full Business Impact</div>
            <div class="d-desc">Company-wide ROI calculator. Put in a team size and see the total annual savings.</div>
            <div class="d-footer">
              <span class="d-saving">&pound;80k-&pound;120k/yr (5-person team)</span>
              <span class="d-arrow"><i class="fa-solid fa-arrow-right"></i></span>
            </div>
          </a>

        </div>

        <!-- Key messaging -->
        <div style="background:var(--card);border:1px solid var(--border);border-left:3px solid var(--purple-l);border-radius:0 var(--r) var(--r) 0;padding:16px 20px;margin-bottom:12px;">
          <p style="font-size:0.68rem;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:6px;">How to position this</p>
          <p style="font-size:0.88rem;color:var(--off-white);line-height:1.7;">"Most businesses have people spending half their day on repetitive stuff. Automation takes that off their plate. You're not replacing anyone, you're <strong style="color:var(--green);">giving each person back 3-5 hours a day</strong> to focus on work that actually moves the needle."</p>
        </div>

        <div style="background:var(--card);border:1px solid var(--border);border-left:3px solid var(--green);border-radius:0 var(--r) var(--r) 0;padding:14px 18px;">
          <p style="font-size:0.68rem;color:var(--muted);font-weight:600;text-transform:uppercase;letter-spacing:0.08em;margin-bottom:5px;">What to say vs what not to say</p>
          <div style="display:grid;grid-template-columns:1fr 1fr;gap:14px;font-size:0.84rem;">
            <div><span style="color:var(--red);font-weight:700;">&#10007; Don't say:</span><br/><span style="color:var(--muted);">"AI replaces your staff"</span></div>
            <div><span style="color:var(--green);font-weight:700;">&#10003; Do say:</span><br/><span style="color:var(--off-white);">"AI takes the boring stuff off your team's plate so they can focus on what they're actually good at"</span></div>
          </div>
        </div>

      </main>
    </div>
  </div>
</AdminLayout>
